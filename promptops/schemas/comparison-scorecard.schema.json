{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apastra-comparison-scorecard-v3",
  "title": "Comparison Scorecard Specification",
  "description": "Schema for multi-model evaluation scorecards with cost/quality/latency tradeoffs.",
  "type": "object",
  "properties": {
    "suite_id": {
      "type": "string",
      "description": "Reference to the evaluation suite"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of candidate models evaluated",
      "minItems": 1,
      "uniqueItems": true
    },
    "metrics": {
      "type": "object",
      "description": "Per-model metric breakdown",
      "additionalProperties": {
        "type": "object",
        "description": "Model metrics",
        "additionalProperties": {
          "type": "number"
        },
        "minProperties": 1
      },
      "minProperties": 1
    },
    "comparison_tradeoffs": {
      "type": "object",
      "description": "Tradeoff comparisons between models",
      "properties": {
        "cost": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "latency": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "not_evaluated"
      ]
    },
    "runs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "total_cost": {
      "type": "number",
      "minimum": 0
    },
    "schema_version": {
      "const": "3.0"
    },
    "execution_status": {
      "const": "completed"
    },
    "model_results": {
      "type": "object",
      "minProperties": 1,
      "description": "Authoritative per-model threshold policy results.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_evaluated"
            ]
          },
          "metrics": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number"
            }
          },
          "failed_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "status",
          "metrics",
          "failed_criteria"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "suite_id",
    "models",
    "metrics",
    "comparison_tradeoffs",
    "runs",
    "schema_version",
    "execution_status",
    "model_results"
  ],
  "additionalProperties": false
}
