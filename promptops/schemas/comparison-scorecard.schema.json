{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apastra-comparison-scorecard-v2",
  "title": "Comparison Scorecard Specification",
  "description": "Schema for multi-model evaluation scorecards with cost/quality/latency tradeoffs.",
  "type": "object",
  "properties": {
    "suite_id": {
      "type": "string",
      "description": "Reference to the evaluation suite"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of candidate models evaluated",
      "minItems": 1,
      "uniqueItems": true
    },
    "metrics": {
      "type": "object",
      "description": "Per-model metric breakdown",
      "additionalProperties": {
        "type": "object",
        "description": "Model metrics",
        "additionalProperties": {
          "type": "number"
        },
        "minProperties": 1
      },
      "minProperties": 1
    },
    "comparison_tradeoffs": {
      "type": "object",
      "description": "Tradeoff comparisons between models",
      "properties": {
        "cost": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "latency": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "status": {
      "const": "pass"
    },
    "runs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "total_cost": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "status",
    "suite_id",
    "models",
    "metrics",
    "comparison_tradeoffs",
    "runs"
  ],
  "additionalProperties": false
}
