{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apastra-harness-adapter-v3",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier for the harness adapter."
    },
    "type": {
      "type": "string",
      "const": "harness_adapter",
      "description": "Must be 'harness_adapter'."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of capabilities (e.g., ['run_suite', 'trials', 'model_matrix'])."
    },
    "entrypoint": {
      "type": "string",
      "description": "The CLI command or script to invoke the harness."
    },
    "description": {
      "type": "string",
      "description": "Optional description of the harness adapter."
    },
    "env_vars": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required environment variables (e.g., 'OPENAI_API_KEY')."
    },
    "digest": {
      "type": "string",
      "description": "Content digest stored inline."
    },
    "extensions": {
      "type": "object"
    },
    "execution_mode": {
      "enum": [
        "measured",
        "fixture",
        "dry_run"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "object",
      "description": "Optional raw content pins for explicitly declared local files; does not describe dependency closure or authenticity.",
      "properties": {
        "files": {
          "type": "object",
          "minProperties": 1,
          "description": "Safe paths relative to the adapter configuration directory mapped to raw-byte SHA-256 digests.",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "capabilities",
    "entrypoint",
    "execution_mode"
  ],
  "additionalProperties": false
}
