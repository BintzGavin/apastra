{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apastra-suite-v2",
  "title": "Benchmark Suite Specification",
  "description": "Benchmark suite declaring datasets, evaluators, model/provider matrix, trials, budgets, and thresholds.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier for the suite."
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the suite."
    },
    "tier": {
      "type": "string",
      "enum": [
        "smoke",
        "regression",
        "full",
        "release-candidate"
      ],
      "default": "smoke",
      "description": "Execution tier of the suite."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Capability tags for the suite."
    },
    "description": {
      "type": "string",
      "description": "Optional detailed description of the suite's purpose."
    },
    "datasets": {
      "type": "array",
      "description": "Array of dataset references.",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evaluators": {
      "type": "array",
      "description": "Array of evaluator references.",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "model_matrix": {
      "type": "array",
      "description": "Array of model/provider identifiers to run the suite against.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "trials": {
      "type": "integer",
      "description": "Number of times to run the evaluation.",
      "default": 1,
      "minimum": 1
    },
    "budgets": {
      "type": "object",
      "description": "Cost or time limits for the execution.",
      "properties": {
        "cost_budget": {
          "type": "number",
          "description": "Maximum allowed cost in dollars.",
          "minimum": 0
        },
        "time": {
          "type": "integer",
          "description": "Maximum allowed execution time in seconds.",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "description": "Pass/fail criteria mapped to specific metrics.",
      "additionalProperties": {
        "type": "number"
      }
    },
    "extensions": {
      "type": "object"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "sampling_config": {
      "type": "object"
    },
    "timeouts": {
      "type": "object",
      "properties": {
        "run": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "datasets",
    "evaluators",
    "model_matrix",
    "prompt"
  ],
  "additionalProperties": false
}
