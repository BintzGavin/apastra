{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apastra-prompt-package-v2",
  "title": "Prompt Package Manifest",
  "description": "Immutable bundle of prompt specs with a manifest and content digest.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier for the package."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Legacy annotation only. Canonical package identity is computed externally over the complete document."
    },
    "specs": {
      "type": "array",
      "description": "Array of included prompt spec IDs/digests.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "https://promptops.apastra.com/schemas/prompt-spec.schema.json"
          }
        ]
      },
      "minItems": 1
    },
    "version": {
      "type": "string",
      "description": "Optional semantic version for the package."
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata (e.g., provenance, author)."
    },
    "public_interface": {
      "type": "object",
      "description": "Explicit API declaration for the versioned package.",
      "properties": {
        "prompt_id": {
          "type": "string",
          "description": "ID of the primary prompt."
        },
        "variables_schema": {
          "type": "object",
          "description": "JSON Schema for input variables."
        },
        "output_schema": {
          "type": "object",
          "description": "JSON Schema for the expected output."
        },
        "tool_contract": {
          "type": "object",
          "description": "Schema or contract for tool usage."
        }
      },
      "required": [
        "prompt_id",
        "variables_schema"
      ]
    }
  },
  "required": [
    "id",
    "specs"
  ],
  "dependentRequired": {
    "version": [
      "public_interface"
    ]
  }
}
