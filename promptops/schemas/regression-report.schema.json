{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apastra-regression-report-v3",
  "title": "Regression Report Specification",
  "description": "Schema for a regression report output.",
  "type": "object",
  "properties": {
    "cost_delta": {
      "type": "number",
      "description": "The difference in total cost between the candidate and the baseline"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "warning"
      ]
    },
    "baseline_ref": {
      "type": "string",
      "description": "The reference digest or ID"
    },
    "candidate_ref": {
      "type": "string",
      "description": "The digest or ID being tested"
    },
    "evidence": {
      "type": "array",
      "description": "Descriptive pooled metric deltas; per-model results determine the policy outcome.",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "suite_id": {
      "type": "string"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "schema_version": {
      "const": "3.0"
    },
    "model_results": {
      "type": "object",
      "minProperties": 1,
      "description": "Authoritative regression policy results for every requested model.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "pass",
              "fail",
              "warning"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "baseline_ref",
    "candidate_ref",
    "evidence",
    "source_revision",
    "suite_id",
    "policy_digest",
    "schema_version",
    "model_results"
  ],
  "additionalProperties": false
}
